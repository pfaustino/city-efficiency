{
  "name": "city-efficiency",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/generate-pages.ts --dev && vite",
    "build": "tsc && tsx scripts/generate-pages.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "update-data": "tsx scripts/update-data.ts",
    "generate-pages": "tsx scripts/generate-pages.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.4"
  }
}
